{
  "cli_default_open_behavior": "new_window",
  "buffer_font_family": ".ZedMono",
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "semantic_tokens": "off",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "font_family": ".ZedMono",
    "font_size": 16,
    "font_fallbacks": ["MesloLGS Nerd Font Mono"],
    "dock": "right",
  },
  "project_panel": {
    "git_status": true,
    "auto_fold_dirs": false,
  },
  "git": {
    "git_gutter": "hide",
  },
  "outline_panel": {
    "git_status": true,
  },
  "base_keymap": "VSCode",
  "status_bar": {
    "experimental.show": true,
  },
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "git_status": true,
  },
  "minimap": {
    "show": "never",
  },

  "scrollbar": {
    "git_diff": false,
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "cursor_shape": "block",
  "cursor_blink": false,
  "linked_edits": true,
  "show_whitespaces": "none",
  "format_on_save": "on",
  "indent_guides": {
    "enabled": true,
  },
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "ui_font_size": 14.5,
  "ui_font_family": ".ZedMono",
  "buffer_font_size": 17.2,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "CodeSandbox",
  },
  "ui_font_weight": 100,
  "buffer_font_weight": 100,
  "buffer_line_height": "comfortable",
}
